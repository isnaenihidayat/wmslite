APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# DB_CONNECTION=sqlite is the historical local-dev default in this file, but
# the real production/shared target is MySQL (the same instance the legacy
# Yii app uses — see process/context/database/all-database.md). For any
# environment other than a quick local smoke test, set DB_CONNECTION=mysql
# and fill in the block below. Local dev, staging, and production will all
# have DIFFERENT DB_HOST/DB_DATABASE/DB_USERNAME/DB_PASSWORD values — never
# share credentials across environments.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=wmslite
# DB_USERNAME=TBD
# DB_PASSWORD=TBD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# --- Cache (also backs the Phase 3 login rate limiter) ------------------
# CACHE_STORE is the driver used by Laravel's default cache facade, which is
# also what the Phase 3 named "login" rate limiter (RateLimiter::for, see
# AppServiceProvider::boot()) relies on for its email+ip 5/min counter — no
# separate dedicated rate-limiter cache env var exists; it reuses this store.
# `database` is fine for a single app instance (current local-dev reality).
# If a future VPS deployment ever runs MULTIPLE app instances behind a load
# balancer, this MUST become a shared store reachable by all instances (e.g.
# Redis below) or the rate limit is effectively multiplied by instance count.
# See process/features/go-live/backlog/rate-limiter-cache-backend_NOTE_23-06-26.md
# (Tier 2 / backlog — blocked on VPS topology being decided; not needed yet).
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Only needed if CACHE_STORE (or QUEUE_CONNECTION/SESSION_DRIVER) is switched
# to redis — see the rate-limiter-cache-backend backlog note above. Not used
# today; values below are framework defaults, not real credentials.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Sanctum (API token auth) --------------------------------------------
# Token expiration (config/sanctum.php 'expiration') is hardcoded to 480
# minutes (8 hours) in config, matching the frontend NextAuth session
# maxAge — there is no env var for it and none is needed.
#
# SANCTUM_STATEFUL_DOMAINS and SANCTUM_TOKEN_PREFIX ARE real env-backed
# config keys (Laravel/Sanctum framework defaults, already wired in
# config/sanctum.php) but were previously undocumented here. This app
# currently authenticates via Bearer token (not the stateful-SPA-cookie
# flow), so SANCTUM_STATEFUL_DOMAINS is not actively exercised today, but
# document it for completeness / in case that changes.
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
# SANCTUM_TOKEN_PREFIX=

# --- CORS -----------------------------------------------------------------
# IMPORTANT — known gap, not a Phase 4 fix: config/cors.php currently
# HARDCODES allowed_origins to "http://localhost:3000" directly in the
# config file (go-live Phase 3, Section 9). There is NO env var for this
# today — CORS_ALLOWED_ORIGIN below does NOT exist yet in code; it is
# listed here only as a placeholder for the env var that should be
# introduced before any non-local environment exists, since the allowed
# origin WILL differ per environment (local dev: localhost:3000; staging:
# TBD staging domain; production: TBD production domain) and a hardcoded
# value cannot vary across them. Wiring config/cors.php to read this var
# is tracked as follow-up work, not yet implemented.
# CORS_ALLOWED_ORIGIN=TBD (not yet read by code — see comment above)
