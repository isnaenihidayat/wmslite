# WMS Lite frontend — environment variable documentation (go-live Phase 4, Step 2).
# Copy to .env.local and fill in real values. NEVER commit .env.local — only this
# .example file is tracked in git (see apps/frontend/.gitignore exception for this
# filename).
#
# Confirmed variable names sourced from apps/frontend/src/lib/auth/auth.ts and
# NextAuth v5 framework conventions — cross-checked against
# process/context/all-context.md "Env var groups" section.

# --- Backend API base URL ------------------------------------------------
# Read directly in apps/frontend/src/lib/auth/auth.ts (LARAVEL_API constant)
# and used by every src/lib/api/*.service.ts module via the shared axios
# client. This value is DIFFERENT in every environment:
#   local:      http://localhost:8000/api  (Laravel `php artisan serve` default)
#   staging:    TBD — no staging environment exists yet
#   production: TBD — no production VPS exists yet (see go-live Phase 4 plan,
#               2-Tier Scope Decision: VPS provisioning is deferred to backlog)
NEXT_PUBLIC_LARAVEL_API_URL=http://localhost:8000/api

# --- NextAuth v5 (frontend session/auth) ---------------------------------
# NEXTAUTH_URL: the canonical base URL of THIS frontend app, used by NextAuth
# to construct callback/redirect URLs. Differs per environment, same pattern
# as NEXT_PUBLIC_LARAVEL_API_URL above:
#   local:      http://localhost:3000
#   staging:    TBD — no staging environment exists yet
#   production: TBD — no production VPS exists yet
NEXTAUTH_URL=http://localhost:3000

# NEXTAUTH_SECRET: random secret used by NextAuth to sign/encrypt the JWT
# session token (session.strategy = "jwt", maxAge = 8 hours — see auth.ts).
# Generate a unique, random value per environment (e.g. `openssl rand -base64 32`).
# NEVER reuse the same secret value across local/staging/production, and
# never commit a real value here — placeholder only.
NEXTAUTH_SECRET=TBD

# No other frontend env vars are currently read by the codebase. If a new
# var is introduced, document it here AND cross-check
# process/context/all-context.md "Env var groups" section per the Phase 4
# plan Step 2c requirement.
